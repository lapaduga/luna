# Скопируйте в .env и впишите свой ключ DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_GUARD_MODEL=deepseek-v4-flash
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
PORT=3000

# ---- LLM Gateway (безопасность, см. SECURITY_PROMPT.md) ----
# input guard: block — секрет блокирует запрос; mask — секрет маскируется и пропускается
INPUT_GUARD_MODE=block
# инъекции: block — high-risk блокируется; warn — пропускается с логом; off — выключено
INPUT_GUARD_INJECTION=block
# output guard: stream — живой стрим с окном-задержкой (гибрид); buffer — проверка всего ответа до доставки; off — выключено
OUTPUT_GUARD_MODE=stream
# токен-бюджет на IP в час
TOKEN_BUDGET_PER_HOUR=200000
# примерные цены USD за 1M токенов (для учёта стоимости)
COST_IN_PER_1M=0.27
COST_OUT_PER_1M=1.10
# 1 — дополнительная LLM-классификация спорных входов (flash-моделью)
GUARD_LLM=0
# файл аудита (JSONL, с маской)
AUDIT_LOG=gateway.log
